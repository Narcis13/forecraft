{
  "$schema": "../../../manifest.schema.json",
  "name": "radio",
  "version": "1.1.0",
  "kind": "primitive",
  "category": "forms",
  "description": "Custom styled radio button for single selection within a group, with size variants; inline option rows use cluster data-gap=4 inside their fieldset",

  "changes": [
    {
      "version": "1.1.0",
      "note": "Canonical inline radio options now use cluster data-gap='4' inside the semantic fieldset, keeping the inter-control step wider than each label's internal space-2 step; one option may remain a direct fieldset child.",
      "breaking": false
    }
  ],

  "anatomy": {
    "tag": "input",
    "selector": "[data-ui='radio']",
    "content_model": "inline"
  },

  "slots": {
    "label": {
      "selector": "[data-part='label']",
      "required": false,
      "tag_hint": "span",
      "description": "Text label displayed next to the radio button"
    }
  },

  "variants": {
    "size": {
      "values": ["sm", "md", "lg"],
      "default": "md",
      "attr": "data-size",
      "applied_to": "root"
    }
  },

  "states": {
    "default": { "attr": "data-state=\"default\"", "default": true },
    "checked": { "attr": "checked" },
    "disabled": { "attr": "disabled" }
  },

  "props": {
    "checked": { "type": "boolean", "default": false, "description": "Whether the radio is checked" },
    "disabled": { "type": "boolean", "default": false, "description": "Whether the radio is disabled" },
    "value": { "type": "string", "default": "", "description": "Radio value" },
    "label": { "type": "string", "default": "", "description": "Radio label text" }
  },

  "a11y": {
    "required_attrs": [
      "fieldset + legend for radio groups",
      "each radio needs a wrapping label or aria-label",
      "name attribute groups radios together",
      "type=\"radio\" required on input element"
    ],
    "keyboard": {
      "Tab": "focus radio group",
      "ArrowUp/ArrowLeft": "select previous radio",
      "ArrowDown/ArrowRight": "select next radio",
      "Space": "select focused radio"
    },
    "notes": "fieldset and legend own radio-group semantics. Inside them, two or more inline option labels use cluster data-gap=\"4\"; radio-label keeps the label-to-box gap at space-2. A fieldset containing one direct radio-label needs no cluster."
  },

  "tokens_used": [
    "color-bg", "color-primary", "color-border", "color-border-strong", "color-ring", "radius-full",
    "space-2", "duration-fast", "ease-default", "border-width", "focus-ring-width",
    "focus-ring-offset", "focus-ring-style", "focus-ring-color", "focus-shadow", "disabled-opacity"
  ],

  "templates": {
    "html": "<fieldset data-ui=\"radio-group\">\n  <legend data-ui=\"label\">{legend}</legend>\n  <div data-ui=\"cluster\" data-gap=\"4\">\n    <label data-ui=\"radio-label\" for=\"{id1}\"><input data-ui=\"radio\" id=\"{id1}\" type=\"radio\" name=\"{name}\" value=\"{value1}\"><span data-part=\"label\">{label1}</span></label>\n    <label data-ui=\"radio-label\" for=\"{id2}\"><input data-ui=\"radio\" id=\"{id2}\" type=\"radio\" name=\"{name}\" value=\"{value2}\"><span data-part=\"label\">{label2}</span></label>\n  </div>\n</fieldset>",
    "html_group": "<fieldset data-ui=\"radio-group\">\n  <legend data-ui=\"label\">{legend}</legend>\n  <div data-ui=\"cluster\" data-gap=\"4\">\n    <label data-ui=\"radio-label\" for=\"{id1}\"><input data-ui=\"radio\" id=\"{id1}\" type=\"radio\" name=\"{name}\" value=\"{value1}\"><span data-part=\"label\">{label1}</span></label>\n    <label data-ui=\"radio-label\" for=\"{id2}\"><input data-ui=\"radio\" id=\"{id2}\" type=\"radio\" name=\"{name}\" value=\"{value2}\"><span data-part=\"label\">{label2}</span></label>\n  </div>\n</fieldset>",
    "html_single": "<fieldset data-ui=\"radio-group\">\n  <legend data-ui=\"label\">{legend}</legend>\n  <label data-ui=\"radio-label\" for=\"{id}\">\n    <input data-ui=\"radio\" id=\"{id}\" type=\"radio\" name=\"{name}\" value=\"{value}\">\n    <span data-part=\"label\">{label}</span>\n  </label>\n</fieldset>"
  },

  "safe_transforms": [
    "change-size",
    "add-radio-option",
    "remove-radio-option",
    "set-default-checked",
    "change-label-text"
  ],

  "unsafe_transforms": [
    "remove-input-element",
    "remove-fieldset-wrapper",
    "remove-name-attribute",
    "change-type-attribute"
  ],

  "composition": {
    "contains": [],
    "used_in": ["settings-page"]
  },

  "files": {
    "html": "radio.html",
    "css": "radio.css",
    "manifest": "radio.manifest.json"
  },

  "tests": [
    "renders-as-input-radio",
    "checked-state-shows-inner-dot",
    "disabled-state-has-disabled-attribute",
    "sm-size-sets-data-size-sm",
    "radios-share-name-attribute",
    "group-wrapped-in-fieldset-with-legend",
    "native-appearance-is-none",
    "inline-option-rows-use-cluster-gap-4",
    "single-fieldset-option-may-stand-outside-cluster"
  ]
}
