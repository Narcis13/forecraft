{
  "$schema": "../../../manifest.schema.json",
  "name": "combobox",
  "version": "1.1.1",
  "kind": "recipe",
  "category": "forms",
  "description": "Autocomplete input with filtered dropdown list for type-ahead search",
  "changes": [
    {
      "version": "1.1.1",
      "note": "Nested components keep their own parts. The stylesheet reached the input, listbox, options and empty state with descendant selectors, so a component nested inside with parts of the same name took this one's styles. Parts are root > input, root > listbox > option and empty. Every part rule is now a child chain from the root, with the hops in :where(), so no rule changes specificity. No change for markup that follows the template.",
      "breaking": false
    },
    {
      "version": "1.1.0",
      "note": "data-highlighted and data-hidden are now declared. The controller has always written both onto the options (active descendant and filtered-out respectively) and the CSS has always styled them, but no manifest named them. They are states rather than props because a controller writes them: a state is the runtime's vocabulary, a prop is what an author types. 0.8-10's undeclared-attribute rule now makes this class of drift impossible: an attribute a component's CSS selects on that its manifest never declares fails the registry gate.",
      "breaking": false
    }
  ],
  "anatomy": {
    "tag": "div",
    "selector": "[data-ui='combobox']",
    "content_model": "slots"
  },
  "slots": {
    "input": {
      "selector": "[data-part='input']",
      "required": true,
      "tag_hint": "input",
      "description": "Text input with role=combobox for type-ahead search"
    },
    "listbox": {
      "selector": "[data-part='listbox']",
      "required": true,
      "tag_hint": "ul",
      "description": "Dropdown list container with role=listbox"
    },
    "option": {
      "selector": "[data-part='option']",
      "required": true,
      "tag_hint": "li",
      "description": "Individual option with role=option"
    },
    "empty": {
      "selector": "[data-part='empty']",
      "required": false,
      "tag_hint": "li",
      "description": "Empty state message shown when no options match the filter"
    }
  },
  "variants": {
    "size": {
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "attr": "data-size",
      "applied_to": "root"
    }
  },
  "states": {
    "closed": {
      "attr": "data-state=\"closed\"",
      "default": true
    },
    "open": {
      "attr": "data-state=\"open\""
    },
    "highlighted": {
      "attr": "data-highlighted",
      "applied_to": "option",
      "description": "The active descendant of the listbox — the option arrow keys have moved to, mirrored in aria-activedescendant. The controller writes it; only one option carries it at a time"
    },
    "hidden": {
      "attr": "data-hidden",
      "applied_to": "option",
      "description": "An option filtered out by the current query. The controller writes it; hidden options are skipped by keyboard navigation and by the empty-state check"
    },
    "loading": {
      "attr": "data-state=\"loading\""
    }
  },
  "api": {
    "methods": [
      {
        "name": "open",
        "params": ""
      },
      {
        "name": "close",
        "params": ""
      },
      {
        "name": "filter",
        "params": "query"
      },
      {
        "name": "selectOption",
        "params": "index"
      },
      {
        "name": "getValue",
        "params": ""
      },
      {
        "name": "setValue",
        "params": "val"
      },
      {
        "name": "destroy",
        "params": ""
      }
    ]
  },
  "props": {
    "placeholder": {
      "type": "string",
      "default": "",
      "description": "Input placeholder text"
    },
    "value": {
      "type": "string",
      "default": "",
      "description": "Selected value"
    }
  },
  "a11y": {
    "required_attrs": [
      "role=\"combobox\" on input",
      "aria-expanded on input",
      "aria-autocomplete=\"list\" on input",
      "aria-controls on input pointing to listbox id",
      "role=\"listbox\" on listbox",
      "role=\"option\" on each option",
      "aria-selected on active option",
      "aria-activedescendant on the combobox, naming the active option while the list is open"
    ],
    "keyboard": {
      "ArrowDown": "highlight next option",
      "ArrowUp": "highlight previous option",
      "Enter": "select highlighted option",
      "Escape": "close listbox",
      "Home": "highlight first option",
      "End": "highlight last option"
    }
  },
  "tokens_used": [
    "color-bg",
    "color-fg",
    "color-fg-muted",
    "color-border",
    "color-primary-subtle",
    "radius-md",
    "radius-lg",
    "shadow-md",
    "space-1",
    "space-2",
    "space-3",
    "text-sm",
    "text-base",
    "text-xs",
    "z-dropdown",
    "duration-fast",
    "ease-default",
    "font-ui",
    "border-width",
    "focus-ring-color",
    "focus-ring-width"
  ],
  "templates": {
    "html": "<div data-ui=\"combobox\" data-state=\"closed\" data-size=\"{size}\">\n  <input data-part=\"input\" type=\"text\" role=\"combobox\" aria-expanded=\"false\" aria-autocomplete=\"list\" aria-controls=\"{id}-listbox\" placeholder=\"{placeholder}\">\n  <ul data-part=\"listbox\" role=\"listbox\" id=\"{id}-listbox\" hidden>\n    <li data-part=\"option\" role=\"option\" aria-selected=\"false\">{option1}</li>\n    <li data-part=\"option\" role=\"option\" aria-selected=\"false\">{option2}</li>\n    <li data-part=\"empty\" hidden>No results found</li>\n  </ul>\n</div>"
  },
  "safe_transforms": [
    "add-option",
    "remove-option",
    "change-size",
    "change-placeholder",
    "restyle-listbox-background",
    "customize-empty-message"
  ],
  "unsafe_transforms": [
    "remove-combobox-role",
    "remove-listbox-role",
    "remove-option-role",
    "remove-aria-expanded",
    "remove-aria-autocomplete",
    "remove-keyboard-navigation"
  ],
  "composition": {
    "contains": [],
    "used_in": [
      "search-results"
    ]
  },
  "files": {
    "html": "combobox.html",
    "css": "combobox.css",
    "js": "combobox.js",
    "manifest": "combobox.manifest.json"
  },
  "tests": [
    "opens-on-input-focus",
    "closes-on-escape",
    "closes-on-click-outside",
    "filters-options-on-input",
    "shows-empty-state-when-no-match",
    "arrow-down-highlights-next-option",
    "arrow-up-highlights-previous-option",
    "enter-selects-highlighted-option",
    "click-selects-option",
    "input-has-role-combobox",
    "input-has-aria-expanded",
    "input-has-aria-autocomplete-list",
    "listbox-has-role-listbox",
    "options-have-role-option",
    "selected-option-has-aria-selected-true"
  ]
}
