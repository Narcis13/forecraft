              "properties": {
                "lineItems": {
                  "type": "object",
                  "title": "Extras",
                  "properties": {
                    "qty": {
                      "type": "number",
                      "title": "Qty"
                    },
                    "amount": {
                      "type": "number",
                      "title": "Amount"
                    }
                  }
                }
              }
            },
            "name": {
              "type": "string",
              "title": "Your name"
            },
            "email": {
              "type": "string",
              "title": "Email"
            },
            "workshop": {
              "type": "string",
              "title": "Workshop"
            },
            "seats": {
              "type": "integer",
              "title": "Seats"
            },
            "payment": {
              "type": "string",
              "title": "Payment"
            },
            "newsletter": {
              "type": "boolean",
              "title": "Newsletter"
            },
            "lineItems": {
              "type": "array",
              "title": "Extras",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "title": "Item"
                  },
                  "qty": {
                    "type": "number",
                    "title": "Qty"
                  },
                  "amount": {
                    "type": "number",
                    "title": "Amount"
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": []
  },
