          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "period": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string"
          },
          "until": {
            "type": "string"
          }
        }
      },
      "count": {
        "type": "integer"
      },
      "columns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
