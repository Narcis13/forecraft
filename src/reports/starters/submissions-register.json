  "layout": [
    {
      "id": "title",
      "block": "title",
      "eyebrow": "Register · {{ period.since != \"\" ? period(period.since, period.until) : \"all submissions\" }}",
      "text": "{{ form.title }}",
      "details": [
        {
          "label": "Submissions",
          "value": "{{ number(count) }}"
        },
        {
          "label": "{{ label(\"period\") }}",
          "value": "{{ period.since != \"\" ? period(period.since, period.until) : \"—\" }}"
        },
        {
          "label": "{{ label(\"reference\") }}",
          "value": "{{ doc.number ?? label(\"draft\") }}"
        }
      ]
    },
    {
      "id": "register",
      "block": "table",
      "rows": "rows",
      "columns": [
        {
          "label": "No.",
          "value": "{{ row.number }}",
          "align": "right",
          "width": "narrow"
        },
        {
          "label": "Date",
          "value": "{{ date(row.submitted_at, \"medium\") }}"
        },
        {
          "label": "Your name",
          "value": "{{ row.name ?? \"—\" }}"
        },
        {
          "label": "Workshop",
          "value": "{{ row.workshop ?? \"—\" }}"
        },
        {
          "label": "Seats",
          "value": "{{ row.seats == null ? \"—\" : number(row.seats) }}",
          "format": "number"
        },
        {
          "label": "Payment",
          "value": "{{ row.payment ?? \"—\" }}"
        },
        {
          "label": "Extras: Amount",
          "value": "{{ number(row.totals.lineItems.amount) }}",
          "format": "number"
        }
      ],
      "footer": [
        {
          "label": "Total",
          "value": "{{ number(sum(rows, \"seats\")) }}"
        }
      ],
      "empty": "No submissions in this period."
    },
    {
      "id": "footer",
      "block": "footer",
      "lines": [
        "{{ doc.title }} · {{ doc.number ?? label(\"draft\") }}"
      ]
    }
  ],
  "appearance": {
    "theme": "swiss-document",
    "accent": "#1e3a5f",
    "paper": "a4",
    "orientation": "portrait",
    "margins": "normal",
    "type": "inter",
    "density": "compact",
    "locale": "en-GB",
    "currency": "EUR"
  },
  "numbering": {
    "pattern": "REG-{YYYY}-{seq:3}"
  },
  "documentTitle": "{{ form.title }} · {{ period.since != \"\" ? period(period.since, period.until) : \"all submissions\" }}",
  "runningHeader": "Register · {{ form.title }}",
  "source": {
    "kind": "submissions",
    "form": "frm_example"
  }
}
