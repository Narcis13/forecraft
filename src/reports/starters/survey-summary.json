{
  "schema": {
    "type": "object",
    "title": "Survey summary",
    "description": "What a form's respondents said over a period: response counts, Net Promoter Score, distributions, responses over time and verbatims — computed by forecraft from the submissions.",
    "properties": {
      "form": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "period": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string"
          },
          "until": {
            "type": "string"
          }
        }
      },
      "responses": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "first": {
            "type": "string"
          },
          "last": {
            "type": "string"
          }
        }
      },
      "nps": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer"
          },
          "promoters": {
            "type": "integer"
          },
          "passives": {
            "type": "integer"
          },
          "detractors": {
            "type": "integer"
          },
          "answered": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "share": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "verbatims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "question": {
              "type": "string"
            }
          }
        }
      },
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "answered": {
              "type": "integer"
            },
            "skipped": {
              "type": "integer"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer"
                  },
                  "share": {
                    "type": "number"
                  }
                }
              }
            },
            "mean": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "median": {
              "type": "number"
            },
            "top": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                },
                "share": {
                  "type": "number"
                }
              }
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "overTime": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
