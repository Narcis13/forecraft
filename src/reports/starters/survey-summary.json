  "layout": [
    {
      "id": "title",
      "block": "title",
      "eyebrow": "{{ label(\"summary\") }} · {{ date(period.since, \"medium\") }} – {{ date(period.until, \"medium\") }}",
      "text": "{{ form.title }}",
      "details": [
        {
          "label": "{{ label(\"responses\") }}",
          "value": "{{ number(responses.total) }}"
        },
        {
          "label": "{{ label(\"period\") }}",
          "value": "{{ date(period.since, \"medium\") }} – {{ date(period.until, \"medium\") }}"
        },
        {
          "label": "Questions",
          "value": "{{ count(questions) }}"
        },
        {
          "label": "{{ label(\"reference\") }}",
          "value": "{{ doc.number ?? label(\"draft\") }}"
        }
      ]
    },
    {
      "id": "headline",
      "block": "stats",
      "when": "nps != null",
      "items": [
        {
          "label": "NPS",
          "value": "{{ nps.score > 0 ? \"+\" : \"\" }}{{ nps.score }}",
          "change": "{{ nps.answered }} answers"
        },
        {
          "label": "{{ label(\"promoters\") }}",
          "value": "{{ percent(nps.groups[0].share) }}",
          "change": "{{ nps.promoters }} people, 9–10"
        },
        {
          "label": "{{ label(\"passives\") }}",
          "value": "{{ percent(nps.groups[1].share) }}",
          "change": "{{ nps.passives }} people, 7–8"
        },
        {
          "label": "{{ label(\"detractors\") }}",
          "value": "{{ percent(nps.groups[2].share) }}",
          "change": "{{ nps.detractors }} people, 0–6"
        }
      ]
    },
    {
      "id": "nps",
      "block": "section",
      "numbered": true,
      "title": "{{ label(\"nps\") }}",
      "when": "nps != null",
      "blocks": [
        {
          "id": "nps-text",
          "block": "text",
          "markdown": "The share of promoters minus the share of detractors, from the answers to “{{ nps.question }}”."
        },
        {
          "id": "nps-bars",
          "block": "bars",
          "rows": "nps.groups",
          "label": "{{ row.label }}",
          "value": "row.share",
          "max": "100",
          "display": "{{ percent(row.share) }} · {{ row.count }}"
        }
      ]
    },
    {
      "id": "over-time",
      "block": "section",
      "numbered": true,
      "title": "Responses over time",
      "blocks": [
        {
          "id": "over-time-chart",
          "block": "chart",
          "kind": "column",
          "rows": "overTime",
          "label": "{{ row.label }}",
          "series": [
            {
              "name": "{{ label(\"responses\") }}",
              "value": "row.count"
            }
          ],
          "title": "Responses per period",
          "format": "number"
        }
      ]
    },
    {
      "id": "questions",
      "block": "section",
      "numbered": true,
      "title": "Every question",
      "blocks": [
        {
          "id": "questions-table",
          "block": "table",
          "rows": "questions",
          "columns": [
            {
              "label": "Question",
              "value": "{{ row.title }}",
              "width": "wide"
            },
            {
              "label": "Answered",
              "value": "{{ number(row.answered) }}",
              "format": "number"
            },
            {
              "label": "Most chosen",
              "value": "{{ row.top.label ?? \"—\" }}"
            },
            {
              "label": "Share",
              "value": "{{ (row.top ?? false) ? percent(row.top.share) : \"—\" }}",
              "format": "percent"
            }
          ]
        }
      ]
    },
    {
      "id": "voices",
      "block": "section",
      "numbered": true,
      "title": "In their words",
      "when": "count(verbatims) > 0",
      "blocks": [
        {
          "id": "verbatims",
          "block": "quote",
          "rows": "verbatims",
          "text": "{{ row.text }}",
          "name": "{{ row.question }}",
          "role": "{{ date(row.at) }}"
        }
      ]
    },
    {
      "id": "footer",
      "block": "footer",
      "lines": [
        "{{ form.title }} · {{ number(responses.total) }} {{ label(\"responses\") }} · {{ date(period.since) }} – {{ date(period.until) }}",
        "Computed by forecraft from the stored answers; shares are of the people who answered each question."
      ]
    }
  ],
  "appearance": {
    "theme": "swiss-document",
    "accent": "#b42318",
    "paper": "a4",
    "orientation": "portrait",
    "margins": "normal",
    "type": "inter",
    "density": "comfortable",
    "locale": "en-GB",
    "currency": "EUR"
  },
  "numbering": {
    "pattern": "SUM-{YYYY}-{seq:3}"
  },
  "documentTitle": "{{ form.title }} · {{ date(period.since, \"medium\") }} – {{ date(period.until, \"medium\") }}",
  "runningHeader": "{{ label(\"summary\") }} · {{ form.title }}",
  "source": {
    "kind": "summary",
    "form": "frm_example"
  }
}
