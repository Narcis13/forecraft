layout "layouts/base.faqir"

block title
  | {{ page.title }} — closed

block body
  div(data-ui="backdrop" data-variant="dots" data-intensity="subtle")
    main#main(data-form-page="card")
      div(data-ui="container" data-measure="narrow")
        div(data-ui="reveal" data-variant="rise" data-stagger)
          header(data-form-head)
            span(data-ui="stamp" data-variant="destructive" data-size="lg") {{ page.reason == "full" ? "Full" : "Closed" }}
            h1(data-form-title) {{ page.title }}
          div(data-ui="card" data-size="lg")
            div(data-part="body")
              if page.reason == "full"
                p This form has received all the responses it can take. Thank you for your interest.
              else if page.reason == "unpublished"
                p This form is not published yet. If you are its author, publish it from the dashboard or with the API.
              else
                p This form is no longer accepting responses. If you think that is a mistake, contact whoever sent you the link.
          footer(data-form-foot)
            p(data-ui="text" data-size="sm" data-variant="muted")
              | Made with
              a(data-ui="link" href="/") forecraft
