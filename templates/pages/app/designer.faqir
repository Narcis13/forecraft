layout "layouts/base.faqir"

block title
  | Design · {{ page.title }} — forecraft

block body
  div(data-designer l-data="designer" data-prop-form-id=tojson(page.formId) data-prop-slug=tojson(page.slug) data-prop-starter=tojson(page.starter) data-prop-themes=tojson(page.themes) data-prop-accents=tojson(page.accents) data-prop-defaults=tojson(page.defaults) l-init="init()" @keydown.window="keys($event)")
    header(data-designer-bar data-gap="0")
      div(data-ui="cluster" data-gap="3")
        a(data-ui="button" data-variant="ghost" data-size="sm" :href="formId ? '/app/forms/' + formId : '/app'" aria-label="Back to the form")
          span(data-ui="icon" data-icon="arrow-left" aria-hidden="true")
        label(for="designer-title" data-designer-sr) Form title
        input#designer-title(data-ui="input" data-size="sm" type="text" :value="title" @input="setTitle($event.target.value)")
        span(data-ui="badge" :data-variant="status === 'saved' ? 'success' : status === 'error' ? 'destructive' : 'secondary'" aria-live="polite" l-text="statusText")
      div(data-ui="cluster" data-gap="2")
        div(data-ui="toggle-group" data-variant="segmented" role="radiogroup" aria-label="Layout of the form")
          label(data-part="item" data-state="off")
            input(data-part="control" type="radio" name="designer-mode" value="flat" :checked="mode === 'flat'" @change="setMode('flat')")
            span(data-part="label") One page
          label(data-part="item" data-state="off")
            input(data-part="control" type="radio" name="designer-mode" value="sections" :checked="mode === 'sections'" @change="setMode('sections')")
            span(data-part="label") Sections
          label(data-part="item" data-state="off")
            input(data-part="control" type="radio" name="designer-mode" value="wizard" :checked="mode === 'wizard'" @change="setMode('wizard')")
            span(data-part="label") Wizard
        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="!canUndo()" @click="undo()" aria-label="Undo (Ctrl+Z)" data-shortcut-hint)
          span(data-ui="icon" data-icon="arrow-left" aria-hidden="true")
          | Undo
        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="!canRedo()" @click="redo()" aria-label="Redo (Ctrl+Shift+Z)" data-shortcut-hint)
          | Redo
          span(data-ui="icon" data-icon="arrow-right" aria-hidden="true")
        template(l-if="slug && publishState !== 'draft'")
          a(data-ui="button" data-variant="outline" data-size="sm" :href="'/f/' + slug" target="_blank" rel="noopener")
            span(data-ui="icon" data-icon="external-link" aria-hidden="true")
            | Public link
        button#designer-publish(type="button" data-ui="button" :data-variant="publishState === 'live' ? 'outline' : 'primary'" data-size="sm" :disabled="publishing || publishState === 'live'" :data-state="publishState" :title="publishState === 'live' ? 'The public link serves this version. Change something to publish again.' : ''" @click="publish()")
          span(data-ui="icon" :data-icon="publishState === 'live' ? 'circle-check' : 'send'" aria-hidden="true")
          span(l-text="publishLabel()")
    p(data-designer-narrow)
      span(data-ui="callout" data-variant="info" role="note")
        span(data-part="content") The designer needs a wider screen (at least 1024 pixels). On a phone, open the form's dashboard page — or ask your agent to edit it through the API.
    main#main(data-designer-panes)
      aside(data-designer-palette data-gap="2" aria-label="Field types")
        h2(data-ui="text" data-variant="eyebrow") Add a field
        p(data-ui="text" data-size="xs" data-variant="muted") Drag onto the canvas, or click to add at the end.
        div(data-ui="stack" data-gap="1")
          template(l-for="k in kinds" l-key="k.id")
            button(type="button" data-ui="button" data-variant="ghost" data-size="sm" draggable="true" data-designer-kind @dragstart="dragKind($event, k.id)" @dragend="dragEnd()" @click="addKind(k.id)")
              span(data-ui="icon" :data-icon="k.icon" aria-hidden="true")
              span(l-text="k.label")
      section(data-designer-center aria-label="Canvas" @click="canvasClick($event)")
        div#designer-tabs(data-ui="tabs" data-variant="underline")
          div(data-part="list" role="tablist" aria-label="Designer views")
            button#dt-build(data-part="trigger" role="tab" aria-controls="dp-build" aria-selected="true" @click="tab = 'build'") Build
            button#dt-rules(data-part="trigger" role="tab" aria-controls="dp-rules" aria-selected="false" tabindex="-1" @click="tab = 'rules'") Rules
            button#dt-look(data-part="trigger" role="tab" aria-controls="dp-look" aria-selected="false" tabindex="-1" @click="tab = 'look'") Appearance
            button#dt-json(data-part="trigger" role="tab" aria-controls="dp-json" aria-selected="false" tabindex="-1" @click="tab = 'json'") JSON
            button#dt-preview(data-part="trigger" role="tab" aria-controls="dp-preview" aria-selected="false" tabindex="-1" @click="tab = 'preview'") Preview
          div#dp-build(data-part="panel" role="tabpanel" aria-labelledby="dt-build")
            template(l-if="problems.length")
              div(data-ui="callout" data-variant="destructive" role="alert")
                strong(data-part="title") This version cannot be saved yet
                div(data-part="content")
                  ul
                    template(l-for="p in problems" l-key="p")
                      li(l-text="p")
            div(data-designer-canvas @dragleave="leaveCanvas($event)")
              template(l-for="(section, si) in sections" l-key="section.key")
                div(data-designer-section :data-empty="section.fields.length ? null : ''" :data-drop-target="isDropSection(si) ? '' : null" @dragover="overSection($event, si)" @drop="dropHere($event, si)")
                  template(l-if="mode !== 'flat'")
                    div(data-designer-section-head)
                      span(data-ui="badge" data-variant="primary" l-text="(mode === 'wizard' ? 'Step ' : 'Section ') + (si + 1)")
                      label(:for="'sec-title-' + si" data-designer-sr) Title
                      input(data-ui="input" data-size="sm" type="text" :id="'sec-title-' + si" :value="section.title" @input="setSection(si, 'title', $event.target.value)")
                      div(data-ui="cluster" data-gap="1")
                        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="si === 0" @click="moveSection(si, -1)" aria-label="Move up")
                          span(data-ui="icon" data-icon="arrow-up" aria-hidden="true")
                        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="si === sections.length - 1" @click="moveSection(si, 1)" aria-label="Move down")
                          span(data-ui="icon" data-icon="arrow-down" aria-hidden="true")
                        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="sections.length === 1" @click="removeSection(si)" aria-label="Remove, keeping its fields")
                          span(data-ui="icon" data-icon="trash-2" aria-hidden="true")
                  ul(data-designer-list role="list")
                    template(l-for="(f, fi) in section.fields" l-key="f.name")
                      li(data-designer-item)
                        div(data-designer-drop l-show="isDrop(si, fi)" aria-hidden="true")
                        div(data-designer-field data-ui="card" data-size="sm" tabindex="0" draggable="true" :id="'field-' + f.name" :aria-current="selected === f.name ? 'true' : 'false'" :aria-label="f.title + ', ' + f.kindLabel + (f.required ? ', required' : '') + '. Alt plus arrow keys to move.'" @click="select(f.name)" @keydown="cardKey($event, f.name)" @dragstart="dragField($event, f.name)" @dragend="dragEnd()" @dragover="overField($event, si, fi)" @drop="dropHere($event, si, fi)")
                          div(data-part="body")
                            div(data-ui="cluster" data-gap="3")
                              span(data-ui="icon" data-icon="move" aria-hidden="true" data-designer-grip)
                              span(data-ui="icon" :data-icon="f.icon" aria-hidden="true")
                              div(data-ui="stack" data-gap="0")
                                span(data-ui="text" data-weight="medium" l-text="f.title")
                                span(data-ui="text" data-size="xs" data-variant="muted" l-text="f.kindLabel + ' · ' + f.name")
                              template(l-if="f.required")
                                span(data-ui="badge" data-size="sm") required
                              div(data-ui="cluster" data-gap="1" data-push)
                                button(type="button" data-ui="button" data-variant="ghost" data-size="sm" aria-label="Duplicate" @click.stop="duplicate(f.name)")
                                  span(data-ui="icon" data-icon="copy" aria-hidden="true")
                                button(type="button" data-ui="button" data-variant="ghost" data-size="sm" aria-label="Delete" @click.stop="removeField(f.name)")
                                  span(data-ui="icon" data-icon="trash-2" aria-hidden="true")
                    li(data-designer-end @dragover="overEnd($event, si)" @drop="dropHere($event, si)")
                      div(data-designer-drop l-show="isDrop(si, section.fields.length)" aria-hidden="true")
                      p(data-ui="text" data-size="sm" data-variant="muted" l-text="section.fields.length ? 'Drop here to add at the end' : 'Empty — drag fields here'")
              div(data-ui="cluster" data-gap="2")
                button(type="button" data-ui="button" data-variant="outline" data-size="sm" @click="addSection()")
                  span(data-ui="icon" data-icon="plus" aria-hidden="true")
                  span(l-text="mode === 'wizard' ? 'Add a step' : 'Add a section'")
          div#dp-rules(data-part="panel" role="tabpanel" aria-labelledby="dt-rules" hidden)
            div(data-ui="stack" data-gap="4")
              p(data-ui="text" data-variant="muted") Rules run in the browser as people type, and again on the server when they submit — the same definition, the same verdict.
              ul(data-ui="stack" data-gap="2" role="list")
                template(l-for="r in rulesView" l-key="r.id")
                  li(data-ui="card" data-size="sm")
                    div(data-part="body")
                      div(data-ui="cluster" data-gap="3")
                        span(data-ui="badge" :data-variant="r.verb === 'show' ? 'primary' : r.verb === 'require' ? 'warning' : r.verb === 'compute' ? 'success' : 'secondary'" l-text="r.verb")
                        span(l-text="r.text")
                        button(type="button" data-ui="button" data-variant="ghost" data-size="sm" data-push aria-label="Delete rule" @click="removeRule(r.id)")
                          span(data-ui="icon" data-icon="trash-2" aria-hidden="true")
                template(l-if="!rulesView.length")
                  li
                    p(data-ui="text" data-size="sm" data-variant="muted") No rules yet. Show or hide a field depending on another answer, make it required only then, or calculate a number from others.
              form(data-ui="card" aria-label="New rule" @submit.prevent="addRule()")
                div(data-part="header")
                  h3(data-part="title") New rule
                div(data-part="body")
                  div(data-ui="stack" data-gap="4")
                    div(data-ui="grid" data-cols="1" data-cols-md="2" data-gap="4")
                      div(data-ui="field-group")
                        label(data-part="label" for="rule-verb") Do this
                        div(data-part="input")
                          select#rule-verb(data-ui="select" @change="setDraft('verb', $event.target.value)")
                            option(value="show" :selected="ruleDraft.verb === 'show'") Show the field
                            option(value="hide" :selected="ruleDraft.verb === 'hide'") Hide the field
                            option(value="require" :selected="ruleDraft.verb === 'require'") Require the field
                            option(value="compute" :selected="ruleDraft.verb === 'compute'") Calculate a number
                      div(data-ui="field-group")
                        label(data-part="label" for="rule-target" l-text="ruleDraft.verb === 'compute' ? 'Number field' : 'Field'")
                        div(data-part="input")
                          select#rule-target(data-ui="select" @change="setDraft('target', $event.target.value)")
                            option(value="" :selected="!ruleDraft.target") Choose…
                            template(l-for="f in (ruleDraft.verb === 'compute' ? numberFields() : fieldOptions)" l-key="f.name")
                              option(:value="f.name" :selected="ruleDraft.target === f.name" l-text="f.title")
                    template(l-if="ruleDraft.verb !== 'compute'")
                      div(data-ui="stack" data-gap="3")
                        template(l-if="ruleDraft.conditions.length > 1")
                          div(data-ui="field-group")
                            label(data-part="label" for="rule-match") Combine the conditions
                            div(data-part="input")
                              select#rule-match(data-ui="select" @change="setDraft('match', $event.target.value)")
                                option(value="all" :selected="ruleDraft.match === 'all'") All of them are true (and)
                                option(value="any" :selected="ruleDraft.match === 'any'") Any of them is true (or)
                        template(l-for="(c, ci) in ruleDraft.conditions" l-key="ci")
                          div(data-designer-condition data-ui="grid" data-cols="1" data-cols-md="3" data-gap="3")
                            div(data-designer-pair)
                              label(data-designer-label :for="ci ? 'rule-field-' + ci : 'rule-field'" l-text="ci === 0 ? 'When' : ruleDraft.match === 'any' ? 'Or when' : 'And when'")
                              div
                                select(data-ui="select" :id="ci ? 'rule-field-' + ci : 'rule-field'" @change="setCondition(ci, 'field', $event.target.value)")
                                  option(value="" :selected="!c.field") Choose…
                                  template(l-for="f in fieldOptions" l-key="f.name")
                                    option(:value="f.name" :selected="c.field === f.name" l-text="f.title")
                            div(data-designer-pair)
                              label(data-designer-label :for="ci ? 'rule-op-' + ci : 'rule-op'") Is
                              div
                                select(data-ui="select" :id="ci ? 'rule-op-' + ci : 'rule-op'" @change="setCondition(ci, 'op', $event.target.value)")
                                  template(l-for="o in opsFor(ci)" l-key="o.id")
                                    option(:value="o.id" :selected="c.op === o.id" l-text="o.label")
                            template(l-if="needsValue(ci)")
                              div(data-designer-pair)
                                label(data-designer-label :for="(valueOptions(ci).length ? 'rule-value' : 'rule-value-text') + (ci ? '-' + ci : '')") Value
                                div
                                  template(l-if="valueOptions(ci).length")
                                    select(data-ui="select" :id="'rule-value' + (ci ? '-' + ci : '')" @change="setCondition(ci, 'value', $event.target.value)")
                                      option(value="" :selected="c.value === ''") Choose…
                                      template(l-for="o in valueOptions(ci)" l-key="o")
                                        option(:value="o" :selected="c.value === o" l-text="o")
                                  template(l-if="!valueOptions(ci).length")
                                    input(data-ui="input" :type="valueType(ci)" :id="'rule-value-text' + (ci ? '-' + ci : '')" :value="c.value" @input="setCondition(ci, 'value', $event.target.value)")
                            template(l-if="ruleDraft.conditions.length > 1")
                              button(type="button" data-ui="button" data-variant="ghost" data-size="sm" aria-label="Remove this condition" @click="removeCondition(ci)")
                                span(data-ui="icon" data-icon="x" aria-hidden="true")
                        div
                          button#rule-add-condition(type="button" data-ui="button" data-variant="ghost" data-size="sm" @click="addCondition()")
                            span(data-ui="icon" data-icon="plus" aria-hidden="true")
                            | Add a condition
                    template(l-if="ruleDraft.verb === 'compute'")
                      div(data-ui="stack" data-gap="3")
                        div(data-ui="grid" data-cols="1" data-cols-md="3" data-gap="3")
                          div(data-ui="field-group")
                            label(data-part="label" for="rule-a") Equals
                            div(data-part="input")
                              select#rule-a(data-ui="select" @change="setDraft('a', $event.target.value)")
                                option(value="" :selected="!ruleDraft.a") Choose…
                                template(l-for="f in numberFields()" l-key="f.name")
                                  option(:value="f.name" :selected="ruleDraft.a === f.name" l-text="f.title")
                          div(data-ui="field-group")
                            label(data-part="label" for="rule-math") Operation
                            div(data-part="input")
                              select#rule-math(data-ui="select" @change="setDraft('math', $event.target.value)")
                                option(value="*" :selected="ruleDraft.math === '*'") × times
                                option(value="+" :selected="ruleDraft.math === '+'") + plus
                                option(value="-" :selected="ruleDraft.math === '-'") − minus
                                option(value="/" :selected="ruleDraft.math === '/'") ÷ divided by
                          div(data-ui="field-group")
                            label(data-part="label" for="rule-b") By
                            div(data-part="input")
                              select#rule-b(data-ui="select" @change="setDraft('b', $event.target.value)")
                                option(value="" :selected="!ruleDraft.b") Choose…
                                template(l-for="f in numberFields()" l-key="f.name")
                                  option(:value="f.name" :selected="ruleDraft.b === f.name" l-text="f.title")
                                option(value="#" :selected="ruleDraft.b === '#'") A fixed number…
                        template(l-if="ruleDraft.b === '#'")
                          div(data-ui="field-group")
                            label(data-part="label" for="rule-b-number") Fixed number
                            div(data-part="input")
                              input#rule-b-number(data-ui="input" type="number" step="any" :value="ruleDraft.bNumber" @input="setDraft('bNumber', $event.target.value)")
                        p(data-ui="text" data-size="sm" data-variant="muted") The result fills in as people type, read-only, and the server works it out again from their answers.
                div(data-part="footer")
                  button(type="submit" data-ui="button" data-variant="primary" data-size="sm") Add rule
          div#dp-look(data-part="panel" role="tabpanel" aria-labelledby="dt-look" hidden)
            div(data-ui="grid" data-cols="1" data-cols-md="2" data-gap="4")
              div(data-designer-themes)
                div(data-ui="cluster" data-gap="2")
                  h3#look-theme-label(data-ui="text" data-size="sm" data-weight="medium") Theme
                  span(data-ui="text" data-size="sm" data-variant="muted" l-text="themeName() + ' · each theme is contrast-checked in light and dark'")
                div(data-designer-theme-grid role="radiogroup" aria-labelledby="look-theme-label")
                  template(l-for="t in themes" l-key="t.id")
                    label(data-designer-theme :title="t.note || t.name")
                      input(type="radio" name="look-theme" :value="t.id" :checked="look('theme') === t.id" @change="setLook('theme', t.id)")
                      span(data-designer-swatch :style="swatch(t)" aria-hidden="true")
                        span(data-swatch-surface)
                        span(data-swatch-primary)
                      span(data-designer-theme-name l-text="t.name")
              div(data-ui="field-group")
                label(data-part="label" for="look-accent") Accent
                div(data-part="input")
                  select#look-accent(data-ui="select" @change="setLook('accent', $event.target.value)")
                    template(l-for="t in accents" l-key="t")
                      option(:value="t" :selected="look('accent') === t" l-text="t === 'theme' ? 'The theme’s own' : t")
              div(data-ui="field-group")
                label(data-part="label" for="look-layout") Layout
                div(data-part="input")
                  select#look-layout(data-ui="select" @change="setLook('layout', $event.target.value)")
                    option(value="card" :selected="look('layout') === 'card'") Card — centred, on a backdrop
                    option(value="split" :selected="look('layout') === 'split'") Split — cover image beside the form
                    option(value="page" :selected="look('layout') === 'page'") Page — wide, no card
              div(data-ui="field-group")
                label(data-part="label" for="look-scheme") Light or dark
                div(data-part="input")
                  select#look-scheme(data-ui="select" @change="setLook('scheme', $event.target.value)")
                    option(value="auto" :selected="look('scheme') === 'auto'") Follow the visitor
                    option(value="light" :selected="look('scheme') === 'light'") Always light
                    option(value="dark" :selected="look('scheme') === 'dark'") Always dark
              div(data-ui="field-group")
                label(data-part="label" for="look-cover") Cover image URL
                div(data-part="input")
                  input#look-cover(data-ui="input" type="url" :value="look('coverImage')" placeholder="https://…" @change="setLook('coverImage', $event.target.value)")
              div(data-ui="field-group")
                label(data-part="label" for="look-eyebrow") Eyebrow
                div(data-part="input")
                  input#look-eyebrow(data-ui="input" type="text" :value="look('eyebrow')" placeholder="e.g. Lisbon · 14–15 May" @input="setLook('eyebrow', $event.target.value)")
              div(data-ui="field-group")
                label(data-part="label" for="look-submit") Submit button
                div(data-part="input")
                  input#look-submit(data-ui="input" type="text" :value="look('submitLabel')" @input="setLook('submitLabel', $event.target.value)")
              div(data-ui="field-group")
                label(data-part="label" for="look-redirect") After submitting, go to
                div(data-part="input")
                  input#look-redirect(data-ui="input" type="url" :value="look('redirect')" placeholder="Stay on the thank-you message" @change="setLook('redirect', $event.target.value)")
              div(data-ui="field-group")
                label(data-part="label" for="look-thanks-title") Thank-you title
                div(data-part="input")
                  input#look-thanks-title(data-ui="input" type="text" :value="look('thanksTitle')" @input="setLook('thanksTitle', $event.target.value)")
              div(data-ui="field-group")
                label(data-part="label" for="look-thanks") Thank-you message
                div(data-part="input")
                  textarea#look-thanks(data-ui="textarea" rows="3" :value="look('thanksMessage')" @input="setLook('thanksMessage', $event.target.value)")
          div#dp-json(data-part="panel" role="tabpanel" aria-labelledby="dt-json" hidden)
            div(data-ui="stack" data-gap="3")
              p(data-ui="text" data-size="sm" data-variant="muted") This is the definition the API returns for this form. Edit it here or on the canvas: they are two views of one object.
              template(l-if="jsonError")
                div(data-ui="callout" data-variant="warning" role="status")
                  div(data-part="content" l-text="jsonError")
              div(data-ui="field-group")
                label(data-part="label" for="designer-json") Definition (JSON)
                div(data-part="input")
                  textarea#designer-json(data-ui="textarea" data-designer-json rows="28" spellcheck="false" :value="jsonText" @input="editJson($event.target.value)")
              div(data-ui="cluster" data-gap="2")
                button(type="button" data-ui="button" data-variant="outline" data-size="sm" @click="formatJson()") Format
          div#dp-preview(data-part="panel" role="tabpanel" aria-labelledby="dt-preview" hidden)
            div(data-ui="stack" data-gap="3")
              div(data-ui="cluster" data-gap="3")
                div(data-ui="toggle-group" data-variant="segmented" role="radiogroup" aria-label="Preview size")
                  label(data-part="item" data-state="off")
                    input(data-part="control" type="radio" name="designer-device" value="desktop" l-model="device")
                    span(data-part="label") Desktop
                  label(data-part="item" data-state="off")
                    input(data-part="control" type="radio" name="designer-device" value="phone" l-model="device")
                    span(data-part="label") Phone
                span(data-ui="badge" :data-variant="audit && !audit.counts.error && !audit.counts.critical ? 'success' : 'secondary'" l-text="auditText()")
              div(data-designer-frame :data-device="device")
                iframe#designer-preview(title="Live preview of the public form" loading="lazy")
      aside(data-designer-props data-gap="3" aria-label="Properties")
        template(l-if="!inspecting()")
          div(data-ui="stack" data-gap="4")
            h2(data-ui="text" data-variant="eyebrow") The form
            div(data-ui="field-group")
              label(data-part="label" for="form-title") Title
              div(data-part="input")
                input#form-title(data-ui="input" type="text" :value="title" @input="setTitle($event.target.value)")
            div(data-ui="field-group")
              label(data-part="label" for="form-description") Description
              div(data-part="input")
                textarea#form-description(data-ui="textarea" rows="4" :value="def ? (def.schema.description || '') : ''" @input="setDescription($event.target.value)")
              p(data-part="description") Shown under the title.
            div(data-ui="stack" data-gap="1" data-designer-address)
              span(data-ui="text" data-size="sm" data-weight="medium") Public address
              template(l-if="slug")
                div(data-ui="cluster" data-gap="2")
                  span(data-ui="text" data-size="sm" data-variant="mono" l-text="'/f/' + slug")
                  a(data-ui="link" data-size="sm" :href="settingsHref()") Change
              p(data-ui="text" data-size="xs" data-variant="muted" l-text="!slug ? 'The form is saved, with its address, on your first change.' : publishState === 'draft' ? 'It follows the title until you first publish.' : publishState === 'live' ? 'Live: the public link serves this version.' : 'Live, with unpublished changes.'")
            p(data-ui="text" data-size="sm" data-variant="muted" l-text="tab === 'build' ? 'Select a field on the canvas to edit its label, name, help text, options and validation.' : 'Back on Build, select a field to edit it.'")
            div(data-ui="card" data-size="sm" data-variant="filled")
              div(data-part="body")
                p(data-ui="text" data-size="sm" data-shortcut-hint) Keyboard: Tab to a field, Enter to select it, Alt+↑/↓ to move it, Delete to remove it, Ctrl+Z / Ctrl+Shift+Z to undo and redo.
        template(l-if="inspecting()")
          div(data-ui="stack" data-gap="4")
            div(data-ui="cluster" data-gap="2")
              h2(data-ui="text" data-variant="eyebrow" l-text="field().kindLabel")
              button(type="button" data-ui="button" data-variant="ghost" data-size="sm" data-push @click="selected = ''") Done
            div(data-ui="field-group")
              label(data-part="label" for="prop-title") Label
              div(data-part="input")
                input#prop-title(data-ui="input" type="text" :value="field().title" @input="setProp('title', $event.target.value)")
            div(data-ui="field-group")
              label(data-part="label" for="prop-name") Name
              div(data-part="input")
                input#prop-name(data-ui="input" type="text" :value="field().name" :readonly="field().locked" @change="rename($event.target.value)" aria-describedby="prop-name-hint")
              p#prop-name-hint(data-part="description" l-text="field().locked ? 'Locked: this form is published, and exports, reports and integrations read its answers by this name.' : field().published ? 'Renaming a published field starts a new column in exports and breaks reports that use the old name.' : field().follows ? 'The key in every submission and export. It follows the label until you edit it.' : 'The key in every submission and export.'")
              template(l-if="field().locked")
                div
                  button#prop-name-unlock(type="button" data-ui="button" data-variant="ghost" data-size="sm" @click="unlockName()")
                    span(data-ui="icon" data-icon="lock-open" aria-hidden="true")
                    | Change it anyway
            template(l-if="field().hasPlaceholder")
              div(data-ui="field-group")
                label(data-part="label" for="prop-placeholder") Placeholder
                div(data-part="input")
                  input#prop-placeholder(data-ui="input" type="text" :value="field().placeholder" @input="setProp('placeholder', $event.target.value)")
            template(l-if="field().isScalar")
              div(data-ui="field-group")
                label(data-part="label" for="prop-width") Width
                div(data-part="input")
                  select#prop-width(data-ui="select" :value="field().width" @change="setProp('width', $event.target.value)" aria-describedby="prop-width-hint")
                    option(value="full" :selected="field().width === 'full'") Full row
                    option(value="half" :selected="field().width === 'half'") Half
                    option(value="third" :selected="field().width === 'third'") Third
                p#prop-width-hint(data-part="description") From the tablet tier up; phones stay one column.
            div(data-ui="field-group")
              label(data-part="label" for="prop-help") Help text
              div(data-part="input")
                textarea#prop-help(data-ui="textarea" rows="2" :value="field().description" @input="setProp('description', $event.target.value)")
            div(data-ui="field-group")
              label(data-part="label" for="prop-required") Required
              div(data-part="input")
                input#prop-required(data-ui="switch" type="checkbox" role="switch" :checked="field().required" @change="setProp('required', $event.target.checked)")
            template(l-if="field().hasOptions")
              div(data-ui="field-group")
                label(data-part="label" for="prop-options") Options
                div(data-part="input")
                  textarea#prop-options(data-ui="textarea" rows="5" :value="field().options" @change="setProp('options', $event.target.value)" aria-describedby="prop-options-hint")
                p#prop-options-hint(data-part="description") One per line.
            template(l-if="field().isText")
              div(data-ui="grid" data-cols="2" data-gap="3")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-minlength") Min length
                  div(data-part="input")
                    input#prop-minlength(data-ui="input" type="number" min="0" :value="field().minLength" @change="setProp('minLength', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-maxlength") Max length
                  div(data-part="input")
                    input#prop-maxlength(data-ui="input" type="number" min="1" :value="field().maxLength" @change="setProp('maxLength', $event.target.value)")
            template(l-if="field().isLongText")
              div(data-ui="field-group")
                label(data-part="label" for="prop-verbatim") Quote in reports
                div(data-part="input")
                  input#prop-verbatim(data-ui="switch" type="checkbox" role="switch" :checked="field().verbatim" @change="setProp('verbatim', $event.target.checked)" aria-describedby="prop-verbatim-hint")
                p#prop-verbatim-hint(data-part="description") A survey summary may print these answers word for word. Leave it off for anything personal.
            template(l-if="field().isNumber")
              div(data-ui="stack" data-gap="4")
                template(l-if="field().computed")
                  div(data-ui="callout" data-variant="info" role="note")
                    div(data-part="content") A rule calculates this number. People see the result; they cannot type in it.
                div(data-ui="grid" data-cols="2" data-gap="3")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-number-kind") Numbers
                    div(data-part="input")
                      select#prop-number-kind(data-ui="select" @change="setProp('numberKind', $event.target.value)")
                        option(value="integer" :selected="field().numberKind === 'integer'") Whole numbers
                        option(value="number" :selected="field().numberKind === 'number'") Decimals
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-step") Step
                    div(data-part="input")
                      input#prop-step(data-ui="input" type="number" min="0" step="any" :value="field().step" :placeholder="field().numberKind === 'integer' ? '1' : 'any'" @change="setProp('step', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-min") Minimum
                    div(data-part="input")
                      input#prop-min(data-ui="input" type="number" step="any" :value="field().minimum" @change="setProp('minimum', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-max") Maximum
                    div(data-part="input")
                      input#prop-max(data-ui="input" type="number" step="any" :value="field().maximum" @change="setProp('maximum', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-prefix") Before the number
                    div(data-part="input")
                      input#prop-prefix(data-ui="input" type="text" maxlength="12" placeholder="e.g. €" :value="field().prefix" @input="setProp('prefix', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-suffix") After the number
                    div(data-part="input")
                      input#prop-suffix(data-ui="input" type="text" maxlength="12" placeholder="e.g. seats" :value="field().suffix" @input="setProp('suffix', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-default") Default value
                  div(data-part="input")
                    input#prop-default(data-ui="input" type="number" step="any" :value="field().defaultValue" @change="setProp('default', $event.target.value)")
                  p(data-part="description") Filled in when the form opens; people can change it.
            template(l-if="field().isScale")
              div(data-ui="grid" data-cols="2" data-gap="3")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-scale-from") From
                  div(data-part="input")
                    input#prop-scale-from(data-ui="input" type="number" step="1" min="0" :max="field().scaleTo - 1" :value="field().scaleFrom" @change="setProp('scaleFrom', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-scale-to") To
                  div(data-part="input")
                    input#prop-scale-to(data-ui="input" type="number" step="1" :min="field().scaleFrom + 1" :max="field().scaleFrom + 20" :value="field().scaleTo" @change="setProp('scaleTo', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-min-label") Low end label
                  div(data-part="input")
                    input#prop-min-label(data-ui="input" type="text" placeholder="e.g. Beginner" :value="field().minLabel" @input="setProp('minLabel', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-max-label") High end label
                  div(data-part="input")
                    input#prop-max-label(data-ui="input" type="text" placeholder="e.g. Expert" :value="field().maxLabel" @input="setProp('maxLabel', $event.target.value)")
            template(l-if="field().isDate")
              div(data-ui="grid" data-cols="2" data-gap="3")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-earliest") Earliest date
                  div(data-part="input")
                    input#prop-earliest(data-ui="input" type="date" :value="field().earliest" @change="setProp('formatMinimum', $event.target.value)")
                div(data-ui="field-group")
                  label(data-part="label" for="prop-latest") Latest date
                  div(data-part="input")
                    input#prop-latest(data-ui="input" type="date" :value="field().latest" @change="setProp('formatMaximum', $event.target.value)")
            template(l-if="field().isRepeat")
              div(data-ui="stack" data-gap="4")
                div(data-ui="grid" data-cols="2" data-gap="3")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-min-rows") Fewest rows
                    div(data-part="input")
                      input#prop-min-rows(data-ui="input" type="number" min="0" step="1" :value="field().minItems" @change="setProp('minItems', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-max-rows") Most rows
                    div(data-part="input")
                      input#prop-max-rows(data-ui="input" type="number" min="1" step="1" :value="field().maxItems" @change="setProp('maxItems', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-add-label") Add button
                    div(data-part="input")
                      input#prop-add-label(data-ui="input" type="text" placeholder="Add a row" :value="field().addLabel" @input="setProp('addLabel', $event.target.value)")
                  div(data-ui="field-group")
                    label(data-part="label" for="prop-remove-label") Remove button
                    div(data-part="input")
                      input#prop-remove-label(data-ui="input" type="text" placeholder="Remove row" :value="field().removeLabel" @input="setProp('removeLabel', $event.target.value)")
                h3(data-ui="text" data-size="sm" data-weight="semibold") Columns
                ol(data-designer-columns role="list")
                  template(l-for="col in field().columns" l-key="col.key")
                    li(data-designer-column data-ui="card" data-size="sm")
                      div(data-part="body")
                        div(data-ui="stack" data-gap="2")
                          div(data-ui="cluster" data-gap="1")
                            label(:for="'col-title-' + col.index" data-designer-sr l-text="'Column ' + (col.index + 1) + ' label'")
                            input(data-ui="input" data-size="sm" type="text" :id="'col-title-' + col.index" :value="col.title" @input="setColumn(col.index, 'title', $event.target.value)")
                            button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="col.index === 0" @click="moveColumn(col.index, -1)" :aria-label="'Move ' + col.title + ' earlier'")
                              span(data-ui="icon" data-icon="arrow-up" aria-hidden="true")
                            button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="col.index === field().columns.length - 1" @click="moveColumn(col.index, 1)" :aria-label="'Move ' + col.title + ' later'")
                              span(data-ui="icon" data-icon="arrow-down" aria-hidden="true")
                            button(type="button" data-ui="button" data-variant="ghost" data-size="sm" :disabled="field().columns.length === 1" @click="removeColumn(col.index)" :aria-label="'Remove column ' + col.title")
                              span(data-ui="icon" data-icon="trash-2" aria-hidden="true")
                          span(data-ui="text" data-size="xs" data-variant="muted" l-text="'Key: ' + col.key")
                          div(data-ui="grid" data-cols="2" data-gap="2")
                            div(data-designer-pair)
                              label(data-designer-label :for="'col-type-' + col.index") Type
                              div
                                select(data-ui="select" data-size="sm" :id="'col-type-' + col.index" @change="setColumn(col.index, 'type', $event.target.value)")
                                  template(l-for="t in columnTypes" l-key="t.id")
                                    option(:value="t.id" :selected="col.type === t.id" l-text="t.label")
                            div(data-designer-pair)
                              label(data-designer-label :for="'col-width-' + col.index") Width
                              div
                                select(data-ui="select" data-size="sm" :id="'col-width-' + col.index" @change="setColumn(col.index, 'width', $event.target.value)")
                                  option(value="full" :selected="col.width === 'full'") Full row
                                  option(value="half" :selected="col.width === 'half'") Half
                                  option(value="third" :selected="col.width === 'third'") Third
                          template(l-if="col.type === 'dropdown'")
                            div(data-designer-pair)
                              label(data-designer-label :for="'col-options-' + col.index") Options, one per line
                              div
                                textarea(data-ui="textarea" rows="3" :id="'col-options-' + col.index" :value="col.options" @change="setColumn(col.index, 'options', $event.target.value)")
                          label(data-ui="cluster" data-gap="2")
                            input(data-ui="switch" type="checkbox" role="switch" :id="'col-required-' + col.index" :checked="col.required" @change="setColumn(col.index, 'required', $event.target.checked)")
                            span(data-ui="text" data-size="sm") Required in every row
                div
                  button#prop-add-column(type="button" data-ui="button" data-variant="outline" data-size="sm" @click="addColumn()")
                    span(data-ui="icon" data-icon="plus" aria-hidden="true")
                    | Add a column
            button(type="button" data-ui="button" data-variant="outline" data-size="sm" @click="removeField(field().name)")
              span(data-ui="icon" data-icon="trash-2" aria-hidden="true")
              | Delete this field
    p(data-designer-sr aria-live="polite" l-text="announce")
  div#toasts(data-ui="toast" data-variant="bottom-right" data-part="container" role="region" aria-label="Notifications")

block scripts
  script(src="/designer.js" defer)
