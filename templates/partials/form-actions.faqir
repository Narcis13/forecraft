div(data-ui="cluster" data-gap="2" l-data="publisher" data-prop-form-id=id)
  a(data-ui="button" data-variant="outline" data-size="sm" href="/app/forms/{{ id }}/preview" target="_blank" rel="noopener")
    span(data-ui="icon" data-icon="eye" aria-hidden="true")
    | Preview
  a(data-ui="button" data-variant="outline" data-size="sm" href="/app/forms/{{ id }}/design")
    span(data-ui="icon" data-icon="pencil" aria-hidden="true")
    | Design
  button(type="button" data-ui="button" data-variant="primary" data-size="sm" :disabled="busy" @click="publish()")
    span(data-ui="icon" data-icon="send" aria-hidden="true")
    | {{ draft ? "Publish changes" : "Republish" }}
