//- Block dispatch (inside one container). Generated by hand from one list; the engine has no recursion,
//- so each nesting level has its own dispatcher (FAQIR-UPSTREAM.md #34).
//- `b` is one evaluated block; every block wrapper carries data-block for preflight.
if b.block == "letterhead"
  include "reports/blocks/letterhead.faqir" (b=b)
else if b.block == "title"
  include "reports/blocks/title.faqir" (b=b)
else if b.block == "parties"
  include "reports/blocks/parties.faqir" (b=b)
else if b.block == "facts"
  include "reports/blocks/facts.faqir" (b=b)
else if b.block == "table"
  include "reports/blocks/table.faqir" (b=b)
else if b.block == "totals"
  include "reports/blocks/totals.faqir" (b=b)
else if b.block == "text"
  include "reports/blocks/text.faqir" (b=b)
else if b.block == "callout"
  include "reports/blocks/callout.faqir" (b=b)
else if b.block == "stats"
  include "reports/blocks/stats.faqir" (b=b)
else if b.block == "bars"
  include "reports/blocks/bars.faqir" (b=b)
else if b.block == "chart"
  include "reports/blocks/chart.faqir" (b=b)
else if b.block == "quote"
  include "reports/blocks/quote.faqir" (b=b)
else if b.block == "signature"
  include "reports/blocks/signature.faqir" (b=b)
else if b.block == "qr"
  include "reports/blocks/qr.faqir" (b=b)
else if b.block == "barcode"
  include "reports/blocks/barcode.faqir" (b=b)
else if b.block == "image"
  include "reports/blocks/image.faqir" (b=b)
else if b.block == "stamp"
  include "reports/blocks/stamp.faqir" (b=b)
else if b.block == "separator"
  include "reports/blocks/separator.faqir" (b=b)
else if b.block == "page-break"
  include "reports/blocks/page-break.faqir" (b=b)
else if b.block == "answers"
  include "reports/blocks/answers.faqir" (b=b)
else if b.block == "faqir"
  include "reports/blocks/faqir.faqir" (b=b)
else if b.block == "section"
  include "reports/blocks/section-2.faqir" (b=b)
else if b.block == "columns"
  include "reports/blocks/columns-2.faqir" (b=b)
