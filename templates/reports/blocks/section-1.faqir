//- A heading and the blocks it groups (level 1).
section(data-block=b.id data-report-block="section" data-keep=b.keep aria-labelledby="{{ b.id }}-h")
  h2(id="{{ b.id }}-h")
    if b.number ?? false
      span(data-report-number) {{ b.number }}
    | {{ b.title }}
  each c in b.blocks
    include "reports/dispatch-1.faqir" (b=c)
