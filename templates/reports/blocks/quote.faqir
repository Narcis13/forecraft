div(data-block=b.id data-report-block="quote" data-keep=b.keep)
  figure(data-ui="quote" data-variant="plain" data-size="sm")
    blockquote(data-part="text")
      p {{ b.text }}
    if b.name ?? false
      figcaption(data-part="author")
        span(data-part="name") {{ b.name }}
        if b.role ?? false
          span(data-part="role") {{ b.role }}
